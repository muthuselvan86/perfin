# Copy to .env and choose local passwords; never commit .env.
POSTGRES_PASSWORD=replace-with-postgres-password
PERFIN_MIGRATOR_PASSWORD=replace-with-migrator-password
PERFIN_APP_PASSWORD=replace-with-app-password
# URL-encode passwords in URLs; role password variables above use raw values.
MIGRATION_DATABASE_URL=postgresql://perfin_migrator:replace-with-url-encoded-migrator-password@localhost:5432/perfin
DATABASE_URL=postgresql://perfin_app:replace-with-url-encoded-app-password@localhost:5432/perfin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-console-password
